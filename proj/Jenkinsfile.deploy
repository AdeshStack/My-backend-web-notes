pipeline {

    agent any

    environment {
        DOCKER_IMAGE = "adeshprime17/interview-prep-hub"
        CONTAINER_NAME = "interview-prep"
        APP_PORT = "8094"
    }

    parameters {
        string(
            name: 'IMAGE_BUILD_NUMBER',
            defaultValue: '1',
            description: 'CI build number to deploy'
        )
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {

        stage('Pull Docker Image') {
            steps {
                echo "Pulling Docker image:"
                echo "${DOCKER_IMAGE}:${IMAGE_BUILD_NUMBER}"

                bat """
                    docker pull ${DOCKER_IMAGE}:${IMAGE_BUILD_NUMBER}
                """
            }
        }

        stage('Stop Old Container') {
            steps {
                echo "Stopping old container..."

                bat """
                    docker stop ${CONTAINER_NAME} || exit 0
                    docker rm ${CONTAINER_NAME} || exit 0
                """
            }
        }

        stage('Run Application') {
            steps {
                echo "Starting application version ${IMAGE_BUILD_NUMBER}..."

                bat """
                    docker run -d ^
                        --name ${CONTAINER_NAME} ^
                        -p ${APP_PORT}:${APP_PORT} ^
                        ${DOCKER_IMAGE}:${IMAGE_BUILD_NUMBER}
                """
            }
        }

        stage('Verify Deployment') {
            steps {
                echo "Checking running container..."

                bat """
                    docker ps
                """
            }
        }
    }

    post {

        success {
            echo "CD Pipeline completed successfully!"
            echo "Deployed image: ${DOCKER_IMAGE}:${IMAGE_BUILD_NUMBER}"
            echo "Application: http://localhost:${APP_PORT}"
        }

        failure {
            echo "CD Pipeline failed!"
            echo "Check the stage logs above."
        }
    }
}
